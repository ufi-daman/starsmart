---
import type { PmsPartner, RezeFeatBullet } from '../lib/types';
interface Props {
  partners: PmsPartner[];
  rezeYoutubeId: string;
  rezeFeatHeadline: string;
  rezeFeatText: string;
  rezeBullets: RezeFeatBullet[];
}
const { partners, rezeYoutubeId, rezeFeatHeadline, rezeFeatText, rezeBullets } = Astro.props;
---
<div class="bg-w divider" id="pms">
  <div class="wrap">
    <span class="lbl">Integrace</span>
    <h2>Kompatibilní s vašim rezervačním systémem</h2>
    <p class="sub">STAR Smart se propojuje s předními hotelovými PMS platformami — check-in, přidělení pokoje i přístupová práva se synchronizují automaticky.</p>

    <div class="pms-feat rr">
      <div class="pms-feat-vid">
        <iframe
          src={`https://www.youtube.com/embed/${rezeYoutubeId}`}
          title="STAR Smart × Reze — automatické odbavení hostů na dálku"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy">
        </iframe>
      </div>
      <div class="pms-feat-txt">
        <div class="pms-feat-badge">
          <img src="https://logo.clearbit.com/reze.cz" alt="Reze" onerror="this.style.display='none'">
          Zvýrazněná integrace
        </div>
        <h3 set:html={rezeFeatHeadline}></h3>
        <p>{rezeFeatText}</p>
        <ul class="pms-feat-list">
          {rezeBullets.map(b => (
            <li><span class="ck">✓</span>{b.text}</li>
          ))}
        </ul>
        <a href="#kontakt" class="pms-feat-cta">Chci tuto integraci →</a>
      </div>
    </div>

    <div class="pms-grid rr">
      {partners.map(p => (
        p.isCustom ? (
          <div class="pms-card pms-custom">
            <div class="pms-logo"><span class="pms-logo-api">🔌</span></div>
            <div class="pms-name">{p.name}</div>
            <div class="pms-vendor">{p.vendor}</div>
          </div>
        ) : (
          <div class="pms-card">
            <div class="pms-logo">
              {p.logoUrl && <img src={p.logoUrl} alt={p.name} loading="lazy">}
            </div>
            <div class="pms-name">{p.name}</div>
            <div class="pms-vendor">{p.vendor}</div>
          </div>
        )
      ))}
    </div>
    <p style="text-align:center;font-size:.82rem;color:var(--ink-3);margin-top:16px">
      Nevidíte váš systém? <a href="#kontakt" style="color:var(--navy-l);font-weight:600">Zeptejte se nás →</a>
    </p>
  </div>
</div>
