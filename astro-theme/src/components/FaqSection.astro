---
import type { FaqItem } from '../lib/types';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="bg-w divider" id="faq">
  <div class="wrap">
    <span class="lbl">Časté otázky</span>
    <h2>Než nás kontaktujete</h2>
    <p class="sub">Nejčastější otázky zákazníků před rozhodnutím — o montáži, bezpečnosti, kompatibilitě i servisu.</p>
    <div class="faq-list rr">
      {items.map((item) => (
        <div class="faq-item">
          <button class="faq-q" onclick="toggleFaq(this)">
            {item.question}
            <i class="faq-icon">+</i>
          </button>
          <div class="faq-a"><p>{item.answer}</p></div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
function toggleFaq(btn: HTMLButtonElement) {
  var item = btn.parentElement as HTMLElement;
  var isOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item.open').forEach(function (el) { el.classList.remove('open'); });
  if (!isOpen) item.classList.add('open');
}
</script>
