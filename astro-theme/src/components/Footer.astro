---
// Footer.astro — Static footer with mobile menu overlay and back-to-top button
---

<div class="mob-overlay" id="mobOverlay" onclick="closeMob()" aria-hidden="true"></div>

<div class="mob-menu" id="mobMenu" role="dialog" aria-modal="true" aria-label="Navigační menu">
  <div class="mob-menu-header">
    <div class="mob-menu-logo">
      <span class="logo-badge" style="font-size:.6rem;padding:4px 7px;">STAR</span>
      <span style="font-size:.88rem;font-weight:700;color:#fff;">Smart®</span>
    </div>
    <button class="mob-close" onclick="closeMob()" aria-label="Zavřít menu">✕</button>
  </div>
  <div class="mob-nav">
    <a href="tel:+420377225903" class="mob-phone">📞 +420 377 225 903</a>
    <a href="#produkty" onclick="closeMob()">Produkty</a>
    <a href="#reseni" onclick="closeMob()">Řešení</a>
    <a href="#aplikace" onclick="closeMob()">Aplikace</a>
    <a href="#studie" onclick="closeMob()">Případové studie</a>
    <a href="#recenze" onclick="closeMob()">Recenze zákazníků</a>
    <a href="#clanky" onclick="closeMob()">Články</a>
    <a href="#profis" onclick="closeMob()">Pro instalatéry</a>
    <a href="#faq" onclick="closeMob()">FAQ</a>
    <a href="#kontakt" onclick="closeMob()">Kontakt</a>
    <a href="https://star.hbgroup.cz/register/" target="_blank" class="mob-portal">🔑 Portál STAR →</a>
  </div>
  <div class="mob-menu-footer">
    <a href="#kontakt" onclick="closeMob()" class="mob-cta">Poptávka zdarma</a>
  </div>
</div>

